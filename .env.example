# 複製成 .env 後填入。EXPO_PUBLIC_ 開頭的值會打包進 App，只放可公開的值（anon key 可公開，RLS 保護資料）。
EXPO_PUBLIC_SUPABASE_URL=https://weadwadmdgddoiscpyyd.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 只給 Supabase Edge Functions 用，不要放進 App（supabase secrets set ...）
# GOOGLE_BOOKS_API_KEY=

# 分享連結的網站網址（P4 網頁版書店頁、P5 分享連結）。部署到 EAS Hosting 後填 https://<名稱>.expo.app；有自己的網域後改成 https://bookhaus.app
EXPO_PUBLIC_WEB_URL=
# 網頁版「前往下載」按鈕（上架後再填）
EXPO_PUBLIC_IOS_STORE_URL=
EXPO_PUBLIC_ANDROID_STORE_URL=
