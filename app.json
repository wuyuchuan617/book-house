{
  "expo": {
    "name": "書棲 Bookhaus",
    "slug": "book-house",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookhaus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bookhaus.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bookhaus.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFE8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#8B4F37"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允許書棲讀取照片，才能更換書店的頭貼與背景圖。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允許書棲使用相機，掃描書背的條碼就能直接找到這本書。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ba7482cb-dd1b-4394-a5f6-78279dc90078"
      }
    },
    "owner": "yuchuan617",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ba7482cb-dd1b-4394-a5f6-78279dc90078",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "locales": {
      "zh-Hant": "./locales/zh-Hant.json",
      "en": "./locales/en.json"
    }
  }
}
